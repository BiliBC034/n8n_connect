      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// Text/link shared from another app on the phone\nconst req = $(\"Shared from phone\").first().json;\nconst body = req.body ?? {};\nconst text = String(body.text ?? \"\").trim();\nif (!text) return [{ json: { ok: false, error: { code: \"empty\", message: \"There is nothing to save.\" } } }];\nreturn [{ json: {\n  ok: true,\n  email: String(req.jwtPayload?.email ?? \"\"),\n  text: text.slice(0, 10000),\n  subject: String(body.subject ?? \"\").trim().slice(0, 300),\n  note: String(body.note ?? \"\").trim().slice(0, 2000),\n  isLink: /^https?:\\/\\/\\S+$/.test(text),\n} }];"
      }
    },
    {
      "id": "3092eb58-b28d-4de0-bef0-6ee7b47609f0",
