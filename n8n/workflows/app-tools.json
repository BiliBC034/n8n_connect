      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        480,
        304
      ],
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "77021e18-2e3f-4035-8d41-61f236e70800",
      "name": "Sticky Note 53f43089",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        208,
        -96
      ],
      "parameters": {
        "content": "## Demo app: Tools\n**GET** returns a live panel (`refreshSeconds: 30`) with metrics, progress and the table of the latest shared items (nc_inbox), an alarm screen, a form (slider, stepper, checkbox, multiselect) and a list of phone actions.\n\n**POST /echo** returns `state` + `screen` and, if requested, the `set_timer` action with confirmation.\n\n**POST /alarm** validates the time and responds with `set_alarm`, or sends it via push with **Send to phone**.",
        "height": 224,
        "width": 640,
        "color": 5
      }
    },
