    {
      "id": "36c742b3-5c9f-4306-a184-473e89946631",
      "name": "Preparar alarma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        620
      ],
      "parameters": {
        "jsCode": "// Valida la hora enviada por la app y construye la acción de dispositivo\nconst req = $(\"Poner alarma\").first().json;\nconst body = req.body ?? {};\nconst match = /^(\\d{1,2}):(\\d{2})$/.exec(String(body.alarma_hora ?? \"\").trim());\nif (!match || Number(match[1]) > 23 || Number(match[2]) > 59) {\n  return [{ json: { ok: false, status: 400, error: { code: \"bad_time\", message: \"Hora no válida (usa HH:mm).\" } } }];\n}\nconst hour = Number(match[1]);\nconst minute = Number(match[2]);\nconst label = String(body.alarma_etiqueta ?? \"\").trim().slice(0, 60) || \"Alarma n8n\";\nconst hhmm = String(hour).padStart(2, \"0\") + \":\" + String(minute).padStart(2, \"0\");\nreturn [{ json: {\n  ok: true,\n  push: body.alarma_push === true || body.alarma_push === \"true\",\n  email: String(req.jwtPayload?.email ?? \"\"),\n  hhmm,\n  label,\n  action: { type: \"set_alarm\", hour, minute, label },\n} }];"
      }
    },
