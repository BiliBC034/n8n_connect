    {
      "id": "36c742b3-5c9f-4306-a184-473e89946631",
      "name": "Prepare alarm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        620
      ],
      "parameters": {
        "jsCode": "// Validates the time sent by the app and builds the device action\nconst req = $(\"Set alarm\").first().json;\nconst body = req.body ?? {};\nconst match = /^(\\d{1,2}):(\\d{2})$/.exec(String(body.alarm_time ?? \"\").trim());\nif (!match || Number(match[1]) > 23 || Number(match[2]) > 59) {\n  return [{ json: { ok: false, status: 400, error: { code: \"bad_time\", message: \"Invalid time (use HH:mm).\" } } }];\n}\nconst hour = Number(match[1]);\nconst minute = Number(match[2]);\nconst label = String(body.alarm_label ?? \"\").trim().slice(0, 60) || \"n8n alarm\";\nconst hhmm = String(hour).padStart(2, \"0\") + \":\" + String(minute).padStart(2, \"0\");\nreturn [{ json: {\n  ok: true,\n  push: body.alarm_push === true || body.alarm_push === \"true\",\n  email: String(req.jwtPayload?.email ?? \"\"),\n  hhmm,\n  label,\n  action: { type: \"set_alarm\", hour, minute, label },\n} }];"
      }
    },
