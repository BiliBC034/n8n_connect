    {
      "id": "45e8b884-7f10-48f0-8f48-3e74d6cae687",
      "name": "Respond with actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        304
      ],
      "parameters": {
        "jsCode": "// Form echo + optional action (with confirmation) for the phone\nconst body = $(\"Form\").first().json.body ?? {};\nconst minutes = Math.min(Math.max(Number.parseInt(body.minutes, 10) || 1, 1), 60);\nconst topics = Array.isArray(body.topics) ? body.topics.map(String) : [];\nconst wantsTimer = body.timer === true || body.timer === \"true\";\nconst echo = \"Volume \" + (body.volume ?? \"?\") + \"% · \" + minutes + \" min · topics: \" + (topics.join(\", \") || \"none\");\n\nreturn [{ json: {\n  message: \"n8n received the form\",\n  screen: \"result\",\n  state: { echo },\n  actions: wantsTimer\n    ? [{ type: \"set_timer\", seconds: minutes * 60, label: \"n8n Connect\", confirm: { title: \"Timer\", message: \"Start a \" + minutes + \" min timer?\" } }]\n    : [],\n} }];"
      }
    },
    {
      "id": "bf48eb25-c9e2-48a9-b535-c5d99fba6f1d",
