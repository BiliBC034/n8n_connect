    {
      "id": "45e8b884-7f10-48f0-8f48-3e74d6cae687",
      "name": "Responder con acciones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        304
      ],
      "parameters": {
        "jsCode": "// Eco del formulario + acción opcional (con confirmación) para el móvil\nconst body = $(\"Formulario\").first().json.body ?? {};\nconst minutos = Math.min(Math.max(Number.parseInt(body.minutos, 10) || 1, 1), 60);\nconst temas = Array.isArray(body.temas) ? body.temas.map(String) : [];\nconst quiereTimer = body.temporizador === true || body.temporizador === \"true\";\nconst eco = \"Volumen \" + (body.volumen ?? \"?\") + \"% · \" + minutos + \" min · temas: \" + (temas.join(\", \") || \"ninguno\");\n\nreturn [{ json: {\n  message: \"n8n recibió el formulario\",\n  screen: \"resultado\",\n  state: { eco },\n  actions: quiereTimer\n    ? [{ type: \"set_timer\", seconds: minutos * 60, label: \"n8n Connect\", confirm: { title: \"Temporizador\", message: \"¿Iniciar un temporizador de \" + minutos + \" min?\" } }]\n    : [],\n} }];"
      }
    },
    {
      "id": "bf48eb25-c9e2-48a9-b535-c5d99fba6f1d",
