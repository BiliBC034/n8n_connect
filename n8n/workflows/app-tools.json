    {
      "id": "28d00921-569a-4de0-b202-1a699b3611c5",
      "name": "Build screen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// Component demo (grid, metric, progress, table, slider, stepper, checkbox,\n// multiselect) and phone actions. Refreshes itself every 30 s (refreshSeconds).\nconst user = $(\"Screen\").first().json.jwtPayload ?? {};\nconst shared = $input.all().map((i) => i.json).filter((r) => r.text)\n  .sort((a, b) => String(b.received_at).localeCompare(String(a.received_at)));\nconst short = (s, n) => (s.length > n ? s.slice(0, n - 1) + \"…\" : s);\nconst rows = shared.slice(0, 5).map((r) => [\n  $now.constructor.fromISO(String(r.received_at)).setZone($now.zoneName).toFormat(\"dd/MM HH:mm\"),\n  short(String(r.subject || r.text), 40),\n]);\n\nconst panel = [\n  { type: \"grid\", columns: 2, components: [\n    { type: \"metric\", label: \"Server time\", value: \"{{server_time}}\", icon: \"schedule\" },\n    { type: \"metric\", label: \"Shared\", value: \"{{shared_items}}\", icon: \"send\", tone: shared.length ? \"success\" : \"info\", caption: \"from the phone\" },\n  ] },\n  { type: \"progress\", label: \"Seconds of the minute\", value: \"{{seconds}}\", max: 60 },\n  { type: \"text\", style: \"subtitle\", text: \"Latest shared items\" },\n  rows.length\n    ? { type: \"table\", columns: [\"Date\", \"Content\"], rows }\n    : { type: \"banner\", tone: \"info\", text: \"Share a link from any app with “Share → n8n Connect” and it will appear here.\" },\n  { type: \"button\", label: \"Set alarm\", icon: \"alarm\", action: { type: \"navigate\", screen: \"alarm\" } },\n  { type: \"button\", label: \"Test form\", icon: \"edit\", style: \"tonal\", action: { type: \"navigate\", screen: \"form\" } },\n  { type: \"button\", label: \"Phone actions\", icon: \"bolt\", style: \"outlined\", action: { type: \"navigate\", screen: \"phone_actions\" } },\n];\n\nconst alarm = [\n  { type: \"banner\", tone: \"info\", icon: \"info\", text: \"n8n validates the time and returns the set_alarm action; the app creates it in the phone's clock app.\" },\n  { type: \"time\", key: \"alarm_time\", label: \"Time\" },\n  { type: \"input\", key: \"alarm_label\", label: \"Label\", hint: \"E.g. Gym\" },\n  { type: \"switch\", key: \"alarm_push\", label: \"Send via push\", description: \"n8n sends it as a notification to all your devices\" },\n  { type: \"button\", label: \"Set alarm\", icon: \"alarm_add\", action: {\n    type: \"submit\", path: \"n8n-connect/apps/tools/alarm\", keys: [\"alarm_time\", \"alarm_label\", \"alarm_push\"], loading: \"Sending to n8n…\",\n  } },\n];\n\nconst form = [\n  { type: \"slider\", key: \"volume\", label: \"Volume\", min: 0, max: 100, step: 5, unit: \"%\" },\n  { type: \"stepper\", key: \"minutes\", label: \"Timer (min)\", min: 1, max: 60 },\n  { type: \"checkbox\", key: \"timer\", label: \"Start the timer when sending\", description: \"n8n responds with the set_timer action\" },\n  { type: \"multiselect\", key: \"topics\", label: \"Topics\", options: [\n    { value: \"n8n\", label: \"n8n\" }, { value: \"flutter\", label: \"Flutter\" }, { value: \"gym\", label: \"Gym\" },\n  ] },\n  { type: \"button\", label: \"Send to n8n\", icon: \"send\", action: {\n    type: \"submit\", path: \"n8n-connect/apps/tools/echo\", keys: [\"volume\", \"minutes\", \"timer\", \"topics\"], loading: \"Sending…\",\n  } },\n];\n\nconst phone_actions = [\n  { type: \"list\", items: [\n    { title: \"Share a text\", icon: \"send\", action: { type: \"share\", text: \"Hello from n8n Connect 👋\" } },\n    { title: \"Open in maps\", subtitle: \"Madrid\", icon: \"location_on\", action: { type: \"maps\", query: \"Puerta del Sol, Madrid\" } },\n    { title: \"Get directions\", icon: \"directions_car\", action: { type: \"maps\", query: \"Puerta del Sol, Madrid\", navigate: true } },\n    { title: \"Wi-Fi settings\", icon: \"settings\", action: { type: \"open_settings\", panel: \"wifi\" } },\n    { title: \"View my alarms\", icon: \"alarm\", action: { type: \"show_alarms\" } },\n    { title: \"Vibrate\", icon: \"bolt\", action: { type: \"vibrate\", style: \"heavy\" } },\n    { title: \"Email me\", subtitle: user.email ?? \"\", icon: \"email\", action: { type: \"email\", to: user.email ?? \"\", subject: \"From n8n Connect\", body: \"Sent from the Tools app\" } },\n    { title: \"Copy the clipboard to the app\", icon: \"edit\", action: { type: \"read_clipboard\", key: \"clipboard\" } },\n  ] },\n  { type: \"details\", items: [{ label: \"Clipboard\", value: \"{{clipboard}}\" }], visible: \"{{clipboard}}\" },\n];\n\nreturn [{ json: {\n  schema: 1,\n  title: \"Tools\",\n  start: \"panel\",\n  refreshSeconds: 30,\n  state: {\n    server_time: $now.toFormat(\"HH:mm:ss\"),\n    seconds: $now.second,\n    shared_items: shared.length,\n    volume: 40,\n    minutes: 5,\n    timer: false,\n    topics: [\"n8n\"],\n    alarm_time: $now.plus({ hours: 1 }).startOf(\"hour\").toFormat(\"HH:mm\"),\n    alarm_label: \"n8n alarm\",\n    alarm_push: false,\n  },\n  screens: [\n    { id: \"panel\", title: \"Live panel\", components: panel },\n    { id: \"alarm\", title: \"Set alarm\", components: alarm },\n    { id: \"alarm_done\", title: \"Done\", components: [\n      { type: \"banner\", tone: \"success\", icon: \"check_circle\", text: \"{{alarm_result}}\" },\n      { type: \"button\", label: \"Another alarm\", icon: \"arrow_back\", style: \"outlined\", action: { type: \"navigate\", screen: \"alarm\" } },\n    ] },\n    { id: \"form\", title: \"Form\", components: form },\n    { id: \"phone_actions\", title: \"Phone actions\", components: phone_actions },\n    { id: \"result\", title: \"Received by n8n\", components: [\n      { type: \"banner\", tone: \"success\", icon: \"check_circle\", text: \"{{echo}}\" },\n      { type: \"button\", label: \"Back to panel\", icon: \"arrow_back\", style: \"outlined\", action: { type: \"navigate\", screen: \"panel\" } },\n    ] },\n  ],\n} }];"
      }
    },
