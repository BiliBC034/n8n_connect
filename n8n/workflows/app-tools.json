    {
      "id": "28d00921-569a-4de0-b202-1a699b3611c5",
      "name": "Construir pantalla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// Demo de componentes (grid, metric, progress, table, slider, stepper, checkbox,\n// multiselect) y acciones del móvil. Se refresca sola cada 30 s (refreshSeconds).\nconst user = $(\"Pantalla\").first().json.jwtPayload ?? {};\nconst shared = $input.all().map((i) => i.json).filter((r) => r.text)\n  .sort((a, b) => String(b.received_at).localeCompare(String(a.received_at)));\nconst short = (s, n) => (s.length > n ? s.slice(0, n - 1) + \"…\" : s);\nconst rows = shared.slice(0, 5).map((r) => [\n  $now.constructor.fromISO(String(r.received_at)).setZone($now.zoneName).toFormat(\"dd/MM HH:mm\"),\n  short(String(r.subject || r.text), 40),\n]);\n\nconst panel = [\n  { type: \"grid\", columns: 2, components: [\n    { type: \"metric\", label: \"Hora del servidor\", value: \"{{hora}}\", icon: \"schedule\" },\n    { type: \"metric\", label: \"Compartidos\", value: \"{{compartidos}}\", icon: \"send\", tone: shared.length ? \"success\" : \"info\", caption: \"desde el móvil\" },\n  ] },\n  { type: \"progress\", label: \"Segundos del minuto\", value: \"{{segundos}}\", max: 60 },\n  { type: \"text\", style: \"subtitle\", text: \"Últimos compartidos\" },\n  rows.length\n    ? { type: \"table\", columns: [\"Fecha\", \"Contenido\"], rows }\n    : { type: \"banner\", tone: \"info\", text: \"Comparte un enlace desde cualquier app con «Compartir → n8n Connect» y aparecerá aquí.\" },\n  { type: \"button\", label: \"Poner alarma\", icon: \"alarm\", action: { type: \"navigate\", screen: \"alarma\" } },\n  { type: \"button\", label: \"Formulario de prueba\", icon: \"edit\", style: \"tonal\", action: { type: \"navigate\", screen: \"form\" } },\n  { type: \"button\", label: \"Acciones del móvil\", icon: \"bolt\", style: \"outlined\", action: { type: \"navigate\", screen: \"acciones\" } },\n];\n\nconst alarma = [\n  { type: \"banner\", tone: \"info\", icon: \"info\", text: \"n8n valida la hora y devuelve la acción set_alarm; la app la crea en el reloj del móvil.\" },\n  { type: \"time\", key: \"alarma_hora\", label: \"Hora\" },\n  { type: \"input\", key: \"alarma_etiqueta\", label: \"Etiqueta\", hint: \"Ej. Gimnasio\" },\n  { type: \"switch\", key: \"alarma_push\", label: \"Enviar por push\", description: \"n8n la manda como notificación a todos tus dispositivos\" },\n  { type: \"button\", label: \"Poner alarma\", icon: \"alarm_add\", action: {\n    type: \"submit\", path: \"n8n-connect/apps/tools/alarm\", keys: [\"alarma_hora\", \"alarma_etiqueta\", \"alarma_push\"], loading: \"Enviando a n8n…\",\n  } },\n];\n\nconst form = [\n  { type: \"slider\", key: \"volumen\", label: \"Volumen\", min: 0, max: 100, step: 5, unit: \"%\" },\n  { type: \"stepper\", key: \"minutos\", label: \"Temporizador (min)\", min: 1, max: 60 },\n  { type: \"checkbox\", key: \"temporizador\", label: \"Iniciar el temporizador al enviar\", description: \"n8n responde con la acción set_timer\" },\n  { type: \"multiselect\", key: \"temas\", label: \"Temas\", options: [\n    { value: \"n8n\", label: \"n8n\" }, { value: \"flutter\", label: \"Flutter\" }, { value: \"gym\", label: \"Gym\" },\n  ] },\n  { type: \"button\", label: \"Enviar a n8n\", icon: \"send\", action: {\n    type: \"submit\", path: \"n8n-connect/apps/tools/echo\", keys: [\"volumen\", \"minutos\", \"temporizador\", \"temas\"], loading: \"Enviando…\",\n  } },\n];\n\nconst acciones = [\n  { type: \"list\", items: [\n    { title: \"Compartir un texto\", icon: \"send\", action: { type: \"share\", text: \"Hola desde n8n Connect 👋\" } },\n    { title: \"Abrir en el mapa\", subtitle: \"Madrid\", icon: \"location_on\", action: { type: \"maps\", query: \"Puerta del Sol, Madrid\" } },\n    { title: \"Cómo llegar\", icon: \"directions_car\", action: { type: \"maps\", query: \"Puerta del Sol, Madrid\", navigate: true } },\n    { title: \"Ajustes de WiFi\", icon: \"settings\", action: { type: \"open_settings\", panel: \"wifi\" } },\n    { title: \"Ver mis alarmas\", icon: \"alarm\", action: { type: \"show_alarms\" } },\n    { title: \"Vibrar\", icon: \"bolt\", action: { type: \"vibrate\", style: \"heavy\" } },\n    { title: \"Escribirme un email\", subtitle: user.email ?? \"\", icon: \"email\", action: { type: \"email\", to: user.email ?? \"\", subject: \"Desde n8n Connect\", body: \"Enviado desde la app Herramientas\" } },\n    { title: \"Copiar el portapapeles a la app\", icon: \"edit\", action: { type: \"read_clipboard\", key: \"portapapeles\" } },\n  ] },\n  { type: \"details\", items: [{ label: \"Portapapeles\", value: \"{{portapapeles}}\" }], visible: \"{{portapapeles}}\" },\n];\n\nreturn [{ json: {\n  schema: 1,\n  title: \"Herramientas\",\n  start: \"panel\",\n  refreshSeconds: 30,\n  state: {\n    hora: $now.toFormat(\"HH:mm:ss\"),\n    segundos: $now.second,\n    compartidos: shared.length,\n    volumen: 40,\n    minutos: 5,\n    temporizador: false,\n    temas: [\"n8n\"],\n    alarma_hora: $now.plus({ hours: 1 }).startOf(\"hour\").toFormat(\"HH:mm\"),\n    alarma_etiqueta: \"Alarma n8n\",\n    alarma_push: false,\n  },\n  screens: [\n    { id: \"panel\", title: \"Panel en vivo\", components: panel },\n    { id: \"alarma\", title: \"Poner alarma\", components: alarma },\n    { id: \"alarma_hecha\", title: \"Listo\", components: [\n      { type: \"banner\", tone: \"success\", icon: \"check_circle\", text: \"{{alarma_resultado}}\" },\n      { type: \"button\", label: \"Otra alarma\", icon: \"arrow_back\", style: \"outlined\", action: { type: \"navigate\", screen: \"alarma\" } },\n    ] },\n    { id: \"form\", title: \"Formulario\", components: form },\n    { id: \"acciones\", title: \"Acciones del móvil\", components: acciones },\n    { id: \"resultado\", title: \"Recibido por n8n\", components: [\n      { type: \"banner\", tone: \"success\", icon: \"check_circle\", text: \"{{eco}}\" },\n      { type: \"button\", label: \"Volver al panel\", icon: \"arrow_back\", style: \"outlined\", action: { type: \"navigate\", screen: \"panel\" } },\n    ] },\n  ],\n} }];"
      }
    },
