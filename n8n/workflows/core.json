    {
      "id": "59365292-499e-4ea0-adda-4d3ade1b550b",
      "name": "Apps del usuario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        704
      ],
      "parameters": {
        "jsCode": "// Solo apps activas y permitidas para el email de la sesión (allowed_emails vacío = todos)\nconst email = String($(\"Apps\").first().json.jwtPayload?.email ?? \"\").toLowerCase();\nconst apps = $input.all()\n  .map((item) => item.json)\n  .filter((row) => row.app_id && row.path)\n  .filter((row) => {\n    const allowed = String(row.allowed_emails ?? \"\").split(\",\").map((s) => s.trim().toLowerCase()).filter(Boolean);\n    return allowed.length === 0 || allowed.includes(email);\n  })\n  .sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0))\n  .map((row) => ({\n    id: row.app_id,\n    name: row.name || row.app_id,\n    description: row.description ?? \"\",\n    icon: row.icon || \"apps\",\n    color: row.color ?? \"\",\n    path: row.path,\n  }));\nreturn [{ json: { apps } }];"
      }
    },
