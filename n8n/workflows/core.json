    {
      "id": "782f4d51-b3c7-4034-acd5-00cbe352287e",
      "name": "Verificar ID token en Firebase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        240,
        304
      ],
      "parameters": {
        "method": "POST",
        "url": "https://identitytoolkit.googleapis.com/v1/accounts:lookup?key=REPLACE_FIREBASE_WEB_API_KEY",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ idToken: String($json.headers.authorization || \"\").replace(/^Bearer\\s+/i, \"\") }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "fb3beb6c-83b8-4dbb-9902-9d7b91dda99f",
      "name": "Validar identidad",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        304
      ],
      "parameters": {
        "jsCode": "// Resultado de Firebase + datos del dispositivo enviados por la app\nconst res = $input.first().json;\nconst req = $(\"Auth\").first().json;\nconst fail = (status, code, message) => [{ json: { ok: false, status, error: { code, message } } }];\n\n// 400 = token rechazado por Google; cualquier otra cosa (429, 5xx, red) = Google no disponible\nif (res.statusCode !== 200) {\n  if (res.statusCode === 400) return fail(401, \"invalid_token\", \"La sesión de Firebase no es válida o ha caducado.\");\n  return fail(424, \"upstream_error\", \"No se pudo verificar la sesión con Google. Inténtalo de nuevo en unos segundos.\");\n}\nconst user = (res.body?.users ?? [])[0];\nif (!user) return fail(401, \"invalid_token\", \"La sesión de Firebase no es válida o ha caducado.\");\nif (user.disabled) return fail(403, \"account_disabled\", \"La cuenta está deshabilitada.\");\nif (!user.email) return fail(403, \"no_email\", \"La cuenta no tiene email.\");\nif (user.emailVerified !== true) return fail(403, \"email_not_verified\", \"Verifica tu email antes de conectar con el servidor.\");\n\nconst device = req.body?.device ?? {};\nconst deviceId = String(device.id ?? \"\").trim();\nif (!/^[A-Za-z0-9_-]{16,64}$/.test(deviceId)) return fail(400, \"invalid_device\", \"Identificador de dispositivo no válido.\");\n\nconst now = Math.floor(Date.now() / 1000);\nreturn [{ json: {\n  ok: true,\n  uid: user.localId,\n  email: user.email.toLowerCase(),\n  displayName: user.displayName ?? \"\",\n  iat: now,\n  exp: now + 12 * 3600,\n  device: {\n    id: deviceId,\n    name: String(device.name ?? \"\").slice(0, 80),\n    platform: String(device.platform ?? \"\").slice(0, 20),\n    fcmToken: String(device.fcmToken ?? \"\").slice(0, 4096),\n    appVersion: String(device.appVersion ?? \"\").slice(0, 40),\n  },\n} }];"
      }
    },
